DATABASE_URL=postgresql://jobnest:jobnest@127.0.0.1:5433/jobnest?schema=public
PORT=4000
FRONTEND_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
NODE_ENV=development
# Restrict first registration to your email. Leave blank to let the first user claim this personal instance.
OWNER_EMAIL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Google identity credentials enable both Google signup and login.
# Create a Web application OAuth client; see docs/google-auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# OpenAI-compatible chat completions endpoint and model
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Optional Brave Search API key for broad web discovery
BRAVE_SEARCH_API_KEY=
