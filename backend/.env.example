DATABASE_URL= 
PORT=4000
FRONTEND_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
NODE_ENV=development
# Restrict first registration to your email. Leave blank to let the first user claim this personal instance.
OWNER_EMAIL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Google identity credentials enable both Google signup and login.
# Create a Web application OAuth client; see docs/google-auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Use your own Ollama server without a paid AI or search API key.
AI_PROVIDER=ollama
# Optional for authenticated proxies; local Ollama does not require a key.
AI_API_KEY=
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
# Optional additional search source. Free feed discovery works without this.
BRAVE_SEARCH_API_KEY=
