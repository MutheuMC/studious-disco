generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  ownerKey String @unique @default("owner")
  email String @unique
  name String
  passwordHash String?
  googleId String? @unique
  createdAt DateTime @default(now())
  profile Profile?
  sessions Session[]
  sources Source[]
  applications Application[]
  documents Document[]
  activities Activity[]
  emails Email[]
  notifications Notification[]
  tasks Task[]
  integration Integration?
  automation AutomationSettings?
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  headline String @default("")
  location String @default("")
  phone String @default("")
  summary String @default("")
  skills String @default("")
  experience String @default("")
  education String @default("")
  roles String @default("")
  countries String @default("Worldwide")
  languages String @default("")
  workEligibility String @default("")
  remoteOnly Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model Source {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  name String
  url String
  notes String @default("")
  enabled Boolean @default(true)
  frequencyHours Int @default(24)
  lastCheckedAt DateTime?
  nextCheckAt DateTime @default(now())
  lastError String?
  jobsFound Int @default(0)
  createdAt DateTime @default(now())
  @@unique([userId,url])
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  company String
  title String
  location String @default("")
  url String?
  dedupeKey String
  description String @default("")
  salary String @default("")
  status String @default("SAVED")
  method String @default("PORTAL")
  contactEmail String @default("")
  deadline DateTime?
  appliedAt DateTime?
  notes String @default("")
  matchReason String @default("")
  matchScore Int?
  discoverySource String?
  requirementsSatisfied Boolean @default(false)
  assessmentProfileUpdatedAt DateTime?
  automationState String @default("NEW")
  reviewReason String?
  applicationInstructions String?
  instructionsVerifiedAt DateTime?
  portalPreparedAt DateTime?
  autoAttemptedAt DateTime?
  sendState String @default("IDLE")
  gmailMessageId String?
  sentSubject String?
  sentBody String?
  sentRecipient String?
  sentDocumentIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  activities Activity[]
  emails Email[]
  @@unique([userId,dedupeKey])
  @@index([userId,status])
}
model Document {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  applicationId String?
  application Application? @relation(fields:[applicationId],references:[id],onDelete:SetNull)
  name String
  kind String @default("CV")
  content String @default("")
  storageKey String?
  mimeType String @default("text/plain")
  originalName String?
  version Int @default(1)
  createdAt DateTime @default(now())
}
model Activity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  applicationId String?
  application Application? @relation(fields:[applicationId],references:[id],onDelete:Cascade)
  message String
  createdAt DateTime @default(now())
}
model Email {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  applicationId String?
  application Application? @relation(fields:[applicationId],references:[id],onDelete:SetNull)
  providerId String
  threadId String
  sender String
  subject String
  snippet String
  suggestedStatus String?
  receivedAt DateTime
  createdAt DateTime @default(now())
  @@unique([userId,providerId])
}
model Integration {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  gmailTokens String?
  gmailEmail String?
  gmailLastSync DateTime?
  gmailPageToken String?
  gmailSyncStartedAt DateTime?
  telegramChatId String?
  telegramPairCode String? @unique
  telegramPairExpires DateTime?
  telegramOffset Int @default(0)
  telegramEnabled Boolean @default(true)
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  body String
  href String @default("/")
  dedupeKey String
  read Boolean @default(false)
  telegramSentAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId,dedupeKey])
}
model Task {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  kind String
  payload Json
  dedupeKey String @unique
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  error String?
  progress String?
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,availableAt])
}
// Public job feeds only; never stores candidate documents or profile data.
model PublicFeedCache {
  url String @id
  payload Json
  fetchedAt DateTime @default(now())
}
model AutomationSettings {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  searchEnabled Boolean @default(true)
  searchIntervalHours Int @default(6)
  nextSearchAt DateTime @default(now())
  lastSearchAt DateTime?
  lastSearchAdded Int @default(0)
  lastSearchError String?
  lastSearchWarnings String?
  workerLastSeenAt DateTime?
  policyRevision Int @default(0)
  autoApplyEnabled Boolean @default(false)
  minMatchScore Int @default(85)
  dailyLimit Int @default(3)
  allowedRoles String[] @default([])
  allowedEmailDomains String[] @default([])
  approvedDocumentIds String[] @default([])
  subjectTemplate String @default("Application for {{title}} — {{name}}")
  bodyTemplate String @default("")
  preparePortalDrafts Boolean @default(true)
  updatedAt DateTime @updatedAt
}
