<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="iisnode.cjs" verb="*" modules="iisnode" resourceType="Unspecified" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="JobNest API" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="iisnode.cjs" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot; --preserve-symlinks --preserve-symlinks-main"
      node_env="production"
      loggingEnabled="true"
      logDirectory="iisnode"
      maxLogFileSizeInKB="1024"
      maxTotalLogFileSizeInKB="10240"
      maxLogFiles="20"
      devErrorsEnabled="false"
      watchedFiles="web.config;.env;*.cjs;dist\*.js"
    />
    <httpErrors existingResponse="PassThrough" />
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment="src" />
          <add segment="dist" />
          <add segment="storage" />
          <add segment="prisma" />
          <add segment="tests" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
